<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.filex.indexd</string>
<key>ProgramArguments</key><array><string>/Applications/Filex.app/Contents/MacOS/filex-indexd</string><string>--user</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
<!-- Stop sends SIGTERM: the daemon saves snapshots and exits 0 (so KeepAlive
     leaves it stopped), then launchd escalates to SIGKILL after this many seconds. -->
<key>ExitTimeOut</key><integer>20</integer>
<key>ProcessType</key><string>Background</string>
</dict></plist>
