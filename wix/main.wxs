<?xml version="1.0" encoding="windows-1252"?>
<!-- Installs the UI and per-user search daemon. The UI launches the sibling
     daemon with its own filesystem permissions. WiX major upgrades remove the
     v1 SCM service through the previous package's uninstall actions.
     Build with cargo-wix / WiX v3; targets x64. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="Filex"
      UpgradeCode="6F3A2E10-9C4B-4D8E-B1F2-7A5C9E0D3B84"
      Manufacturer="Filex Project"
      Language="1033"
      Codepage="1252"
      Version="$(var.Version)">

    <Package
        Id="*"
        Keywords="Installer"
        Description="Filex — fast file explorer and index service"
        Manufacturer="Filex Project"
        InstallerVersion="500"
        Languages="1033"
        Compressed="yes"
        InstallScope="perMachine"
        SummaryCodepage="1252" />

    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of Filex is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="Filex.ico" SourceFile="$(sys.SOURCEFILEDIR)..\assets\branding\filex.ico" />
    <Property Id="ARPPRODUCTICON" Value="Filex.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Filex">

          <Component Id="FilexApp" Guid="*" Win64="yes">
            <File
                Id="FilexExe"
                Name="filex.exe"
                Source="$(var.CargoTargetBinDir)\filex.exe"
                KeyPath="yes" />
          </Component>

          <Component Id="FilexIndexd" Guid="*" Win64="yes">
            <File
                Id="FilexIndexdExe"
                Name="filex-indexd.exe"
                Source="$(var.CargoTargetBinDir)\filex-indexd.exe"
                KeyPath="yes" />
            <!-- The UI starts the daemon in the user's security context.
                 Major upgrades uninstall and remove the old v1 SCM service. -->
          </Component>

        </Directory>
      </Directory>

      <!-- Start-menu shortcut. Without one, Windows Start search has
           nothing to index, so typing "filex" finds nothing (the app is
           installed but unsearchable). The shortcut targets filex.exe in
           INSTALLFOLDER. Per-user HKCU keypath is the standard WiX pattern
           for a non-advertised shortcut; RemoveFolder cleans up the
           per-user Start-menu folder on uninstall. -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="FilexStartMenuFolder" Name="Filex">
          <Component Id="FilexStartMenuShortcut" Guid="*">
            <Shortcut
                Id="FilexShortcut"
                Name="Filex"
                Description="Fast file explorer and instant filename search"
                Target="[INSTALLFOLDER]filex.exe"
                WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveFilexStartMenuFolder" On="uninstall" />
            <RegistryValue
                Root="HKCU"
                Key="Software\Filex"
                Name="StartMenuShortcut"
                Type="integer"
                Value="1"
                KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="Filex" Level="1">
      <ComponentRef Id="FilexApp" />
      <ComponentRef Id="FilexIndexd" />
      <ComponentRef Id="FilexStartMenuShortcut" />
    </Feature>

  </Product>
</Wix>
