<?xml version="1.0" encoding="windows-1252"?>
<!--
  Filex MSI (docs/roadmap.md Phase 2b step 2). Installs the app
  (filex.exe) and registers the elevated index service (filex-indexd.exe)
  as an SCM service, so a single admin-consented install gives standard
  users the USN fast path. Built by cargo-wix (WiX v3): `cargo wix`.

  cargo-wix supplies the preprocessor variables used below: `Version`
  (from Cargo.toml) and `CargoTargetBinDir` (the built-binary directory).
  Targets x64 (the only Windows CI/runner arch today).

  The service is registered auto-start AND started by the installer:
  filex-indexd reports RUNNING before it bootstraps (so the install
  returns promptly), and a stop is now observed between/after bootstrap
  and during the walk (start_live_index_cancellable), so an
  uninstall-time stop no longer waits on the whole initial index.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="Filex"
      UpgradeCode="6F3A2E10-9C4B-4D8E-B1F2-7A5C9E0D3B84"
      Manufacturer="Filex Project"
      Language="1033"
      Codepage="1252"
      Version="$(var.Version)">

    <Package
        Id="*"
        Keywords="Installer"
        Description="Filex — fast file explorer and index service"
        Manufacturer="Filex Project"
        InstallerVersion="500"
        Languages="1033"
        Compressed="yes"
        InstallScope="perMachine"
        SummaryCodepage="1252" />

    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of Filex is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Filex">

          <Component Id="FilexApp" Guid="*" Win64="yes">
            <File
                Id="FilexExe"
                Name="filex.exe"
                Source="$(var.CargoTargetBinDir)\filex.exe"
                KeyPath="yes" />
          </Component>

          <Component Id="FilexIndexd" Guid="*" Win64="yes">
            <File
                Id="FilexIndexdExe"
                Name="filex-indexd.exe"
                Source="$(var.CargoTargetBinDir)\filex-indexd.exe"
                KeyPath="yes" />
            <!-- Register the elevated index service. `Name` must match
                 SERVICE_NAME in src/bin/filex-indexd.rs. The service binary
                 is this component's keypath file. -->
            <!-- No Arguments: the service resolves its roots from
                 settings.json and, on a fresh install with none configured,
                 defaults to every fixed drive (drives::default_index_roots).
                 (SCM does not deliver ImagePath arguments to ServiceMain
                 anyway, so a hard-coded root here would have been silently
                 ignored — see src/bin/filex-indexd.rs.) -->
            <ServiceInstall
                Id="FilexIndexdService"
                Name="filex-indexd"
                DisplayName="Filex Index Service"
                Description="Maintains the Filex file index and serves search over a named pipe."
                Type="ownProcess"
                Start="auto"
                ErrorControl="normal"
                Account="LocalSystem"
                Vital="yes" />
            <!-- Start on install; stop on upgrade/uninstall; remove the
                 registration on uninstall. The service reports RUNNING
                 before bootstrapping, so install returns promptly. -->
            <ServiceControl
                Id="FilexIndexdControl"
                Name="filex-indexd"
                Start="install"
                Stop="both"
                Remove="uninstall"
                Wait="yes" />
          </Component>

        </Directory>
      </Directory>

      <!-- Start-menu shortcut. Without one, Windows Start search has
           nothing to index, so typing "filex" finds nothing (the app is
           installed but unsearchable). The shortcut targets filex.exe in
           INSTALLFOLDER. Per-user HKCU keypath is the standard WiX pattern
           for a non-advertised shortcut; RemoveFolder cleans up the
           per-user Start-menu folder on uninstall. -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="FilexStartMenuFolder" Name="Filex">
          <Component Id="FilexStartMenuShortcut" Guid="*">
            <Shortcut
                Id="FilexShortcut"
                Name="Filex"
                Description="Fast file explorer and instant filename search"
                Target="[INSTALLFOLDER]filex.exe"
                WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveFilexStartMenuFolder" On="uninstall" />
            <RegistryValue
                Root="HKCU"
                Key="Software\Filex"
                Name="StartMenuShortcut"
                Type="integer"
                Value="1"
                KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="Filex" Level="1">
      <ComponentRef Id="FilexApp" />
      <ComponentRef Id="FilexIndexd" />
      <ComponentRef Id="FilexStartMenuShortcut" />
    </Feature>

  </Product>
</Wix>
